# PostgreSQL connection. Either set DATABASE_URL...
DATABASE_URL=postgres://user:password@host:5432/database

# ...or the individual variables the old Express backend used.
# DB_HOSTNAME=
# DB_USERNAME=
# DB_PASSWORD=
# DB_DATABASE=
# DB_PORT=5432

# SSL is on by default (rejectUnauthorized=false). Set to "false" for a local DB without SSL.
# DB_SSL=false
